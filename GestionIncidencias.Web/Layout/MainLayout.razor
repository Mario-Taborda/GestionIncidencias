@inherits LayoutComponentBase

<MudLayout>
   
    <MudAppBar Elevation="1" Style="background-color: #dc3545; color: white;">
     
        <MudIconButton Icon= Color="Color.Inherit" Edge="Edge.Start" />
        <MudText Typo="Typo.h5" Class="ml-3" Style="font-weight: bold;">Gestión de Incidencias</MudText>
    </MudAppBar>

    <MudDrawer Open="true" ClipMode="DrawerClipMode.Always" Elevation="2"
               Style="background-color: #dc3545; color: white;">
        <NavMenu />
    </MudDrawer>

    <MudMainContent Class="mud-height-full" Style="background-color: #f5f5f5;">
        <MudContainer MaxWidth="MaxWidth.Large" Class="my-4 pt-4">
            @Body
        </MudContainer>
    </MudMainContent>

    <MudThemeProvider />
    <MudPopoverProvider />
    <MudSnackbarProvider />
</MudLayout>