@page "/login"
@using GestionIncidencias.Domain.DTO
@using GestionIncidencias.Web.Auth
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject HttpClient Http

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white text-center">
                    <h4>Ingreso de Usuarios</h4>
                </div>
                <div class="card-body">

                    <EditForm Model="loginModel" OnValidSubmit="ProcesarLogin">
                        <DataAnnotationsValidator />

                        <div class="mb-3">
                            <label class="form-label">Correo Electrónico</label>
                            <InputText @bind-Value="loginModel.Email" class="form-control" placeholder="ejemplo@empresa.com" />
                            <ValidationMessage For="@(() => loginModel.Email)" class="text-danger" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Contraseña</label>
                            <InputText @bind-Value="loginModel.Password" type="password" class="form-control" placeholder="******" />
                            <ValidationMessage For="@(() => loginModel.Password)" class="text-danger" />
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary">Iniciar Sesión</button>
                        </div>

                    </EditForm>

                </div>
            </div>
        </div>
    </div>
</div>

@code {
    @code {
        private LoginDTO loginModel = new LoginDTO();
        private string mensajeError = "";

        private async Task ProcesarLogin()
        {
            mensajeError = "";

            try
            {
                var respuesta = await Http.PostAsJsonAsync("api/auth/login", loginModel);

                if (respuesta.IsSuccessStatusCode)
                {
             
                    var customProvider = (CustomAuthStateProvider)AuthStateProvider;
                    customProvider.MarcarUsuarioComoLogueado(loginModel.Email);
                    Navigation.NavigateTo("/incidencia");
                }
                else
                {
            
                    mensajeError = "Correo o contraseña incorrectos. Verifica tus datos.";
                }
            }
            catch (Exception)
            {
                mensajeError = "No se pudo conectar con el servidor. Intenta de nuevo.";
            }
        }
    }
}